{
  "testsDirectory": "Tests",
  "logPath": "logs/install-tests.log",
  "tests": [
    { "name": "Power BI Desktop",     "script": "Test-PowerBIDesktopInstalled.ps1", "enabled": true },
    { "name": "SQL Server installed", "script": "Test-SqlServerInstalled.ps1",      "enabled": true },
    { "name": "SSMS",                 "script": "Test-SSMSInstalled.ps1",           "enabled": true },
    { "name": "Excel",               "script": "Test-ExcelInstalled.ps1",          "enabled": true },
    { "name": "VS Code",              "script": "Test-VSCodeInstalled.ps1",         "enabled": true },
    { "name": "SQL Server running",   "script": "Test-SqlServerRunning.ps1",        "enabled": true },
    { "name": "pub1 database",        "script": "Test-SqlDatabaseExists.ps1", "arguments": { "DatabaseName": "pub1" } },
    { "name": "pub2 database",        "script": "Test-SqlDatabaseExists.ps1", "arguments": { "DatabaseName": "pub2" } },
    { "name": "AdventureWorksDW2020 database", "script": "Test-SqlDatabaseExists.ps1", "arguments": { "DatabaseName": "AdventureWorksDW2020" } },
    { "name": "GoToMyPC running",    "script": "Test-GoToMyPCRunning.ps1",         "enabled": true },
    { "name": "GoToMyPC single instance", "script": "Test-GoToMyPCSingleInstance.ps1", "enabled": true },
    { "name": "Course files",         "script": "Test-FilesPresent.ps1",
      "arguments": { "Path": "C:\\CourseFiles", "ExpectedFiles": ["Data\\sample.csv", "Labs\\lab1.docx"] } }
  ]
}
